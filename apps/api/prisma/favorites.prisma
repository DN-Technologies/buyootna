model Favorite {
  id         String   @id @default(uuid())
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Owning persona
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@unique([identityId, propertyId])
  @@index([identityId])
  @@index([propertyId])
}

// A company or office an identity saved to its favorites (المفضلة → شركات /
// مكاتب). Both sides are identities: the saver and the provider.
model ProviderFavorite {
  id         String   @id @default(uuid())
  identityId String
  identity   Identity @relation("ProviderFavoriteOwner", fields: [identityId], references: [id], onDelete: Cascade)
  providerId String
  provider   Identity @relation("ProviderFavoriteTarget", fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([identityId, providerId])
  @@index([identityId])
  @@index([providerId])
}
