// Plans and what is sold: ad packages, "feature this ad" packages, invoices
// and the ad credits (wallet slots) a paid invoice grants.

model Plan {
  id             String         @id @default(uuid())
  slug           String         @unique // 'regular', 'silver', 'gold'
  name           String // 'العادية', 'الفضية', 'الذهبية'
  price          Float          @default(0)
  originalPrice  Float?
  discountText   String?
  badge          String?
  features       String[] // Postgres array
  color          String         @default("#15304D")
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  maxActiveAds   Int            @default(1)
  durationDays   Int            @default(10)
  maxImagesPerAd Int            @default(5)
  featuredDays   Int            @default(0)
  prioritySearch Boolean        @default(false)
  // Offices have their own plans (Figma 10180:31480); individuals the rest
  audience       PlanAudience   @default(INDIVIDUAL)
  users          User[]
  slots          UserPlanSlot[]
  packages       PlanPackage[]
  // Packages whose featured ads are credited under this plan («اعلان مميز»)
  featuredIn     PlanPackage[]  @relation("PackageFeaturedPlan")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// A purchasable quantity option within a plan tier (e.g. gold × 5 ads).
// The plan carries the per-ad benefits; the package carries the ad count
// and price actually charged.
model PlanPackage {
  id               String    @id @default(uuid())
  planId           String
  // Regular ads, credited under the plan itself
  adsCount         Int
  // Featured ads, credited under featuredPlan (an office bundle's «3 اعلانات
  // مميزة»; a featured single ad has adsCount 0)
  featuredAdsCount Int       @default(0)
  featuredPlanId   String?
  featuredPlan     Plan?     @relation("PackageFeaturedPlan", fields: [featuredPlanId], references: [id], onDelete: SetNull)
  // «صلاحية انتهاء الباقة»: ads not used by then are lost. null: no expiry
  validityMonths   Int?
  price            Float
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  plan             Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([planId, adsCount, featuredAdsCount])
}

// A paid "feature this ad" option (e.g. 7 days for 3 KWD). Admin-editable;
// the charge amount always comes from here, never from the client.
model FeaturePackage {
  id           String    @id @default(uuid())
  label        String
  description  String    @default("")
  durationDays Int
  price        Float
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  invoices     Invoice[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Invoice {
  id          String         @id @default(uuid())
  invoiceNo   String         @unique
  planName    String
  planDetails String?
  amount      Float
  status      InvoiceStatus  @default(PENDING)
  paidAt      DateTime?
  dueDate     DateTime?
  delayDays   Int? // e.g. 5 for notice
  planSlots   UserPlanSlot[]

  // Set for plan purchases so fulfillment knows exactly what was bought
  planId        String?
  planPackageId String?
  planPackage   PlanPackage? @relation(fields: [planPackageId], references: [id], onDelete: SetNull)

  // Set for "feature this ad" purchases instead of a plan. featureDays is
  // the duration paid for, kept even if the package is later edited, and
  // propertyId goes null (invoice kept) if the ad is deleted.
  featurePackageId String?
  featurePackage   FeaturePackage? @relation(fields: [featurePackageId], references: [id], onDelete: SetNull)
  propertyId       String?
  property         Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  featureDays      Int?

  // Set for a company subscription purchase (الباقات)
  companyPlanId       String?
  companyPlan         CompanyPlan?         @relation(fields: [companyPlanId], references: [id], onDelete: SetNull)
  companySubscription CompanySubscription?

  // «كود الخصم»: amount is what was charged; these keep the price before
  // the code and what it took off
  originalAmount     Float?
  discountAmount     Float?
  discountCodeId     String?
  discountCode       DiscountCode?       @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountRedemption DiscountRedemption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owning persona
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@index([identityId])
}

model UserPlanSlot {
  id           String     @id @default(uuid())
  planId       String
  adsRemaining Int
  status       SlotStatus @default(ACTIVE)
  // Unused ads are lost after this (the package's validityMonths from the
  // purchase); null for packages without one
  expiresAt    DateTime?
  invoiceId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id])
  invoice    Invoice?   @relation(fields: [invoiceId], references: [id])
  properties Property[]

  // Owning persona
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@index([identityId])
  @@index([status])
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}
