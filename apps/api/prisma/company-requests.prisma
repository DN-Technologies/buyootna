model CompanyRequest {
  id String @id @default(uuid())

  clientIdentityId String
  clientIdentity   Identity @relation("ClientRequests", fields: [clientIdentityId], references: [id], onDelete: Cascade)

  // null => public/marketplace request (any company can view); set => sent
  // directly to one company and only that company can act on it.
  targetIdentityId String?
  targetIdentity   Identity? @relation("TargetedRequests", fields: [targetIdentityId], references: [id], onDelete: Cascade)

  // Set once a company accepts -- the company that claimed a public request,
  // or (redundantly, for consistency) the targeted company for a directed one.
  acceptedByIdentityId String?
  acceptedByIdentity   Identity? @relation("AcceptedRequests", fields: [acceptedByIdentityId], references: [id], onDelete: SetNull)

  title       String
  category    String?
  priceRange  String?
  // priceRange's two ends (د.ك), for the price filter
  priceMin    Float?
  priceMax    Float?
  location    String
  // القطعة / الشارع / الجادة / المنزل / علامة مميزة, from the location picker
  addressDetails Json?
  latitude    Float?
  longitude   Float?
  offerType   String?
  images      String[] @default([])
  description String

  status    RequestStatus @default(PENDING)
  // انهاء الطلب: the accepting company marked the work finished, and where
  // the final agreement was made (in_app | outside)
  completedAt  DateTime?
  completedVia String?
  invoices  CompanyInvoice[]
  // The answers companies gave (one per company)
  offers    RequestOffer[]
  // Chats opened about this request
  conversations Conversation[]
  // Companies that hid this public request, and that saved it
  dismissals RequestDismissal[]
  bookmarks  RequestBookmark[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([targetIdentityId])
  @@index([clientIdentityId])
  @@index([status])
}

// A company's answer to a request: what it says, any notes and its price.
// One per company and request; the requester accepts or rejects it.
model RequestOffer {
  id                 String             @id @default(uuid())
  requestId          String
  request            CompanyRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerIdentityId String
  provider           Identity           @relation("ProvidedOffers", fields: [providerIdentityId], references: [id], onDelete: Cascade)

  message String?
  // العرض لا يشمل: what the offer leaves out
  excludes String?
  notes   String?
  // What the company asks for (د.ك)
  price   Float?

  status    RequestOfferStatus @default(SENT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([requestId, providerIdentityId])
  @@index([requestId])
}

// A request a company took off its own lists; other companies and the
// client are not affected. kind: rejected (رفض on a public request, shown
// under مرفوضة) or removed (the trash on an accepted request, gone)
model RequestDismissal {
  id         String         @id @default(uuid())
  kind       String         @default("rejected")
  requestId  String
  request    CompanyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  identityId String
  identity   Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([requestId, identityId])
  @@index([identityId])
}

// A request a company saved (اضافة الى المفضلة) to come back to
model RequestBookmark {
  id         String         @id @default(uuid())
  requestId  String
  request    CompanyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  identityId String
  identity   Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([requestId, identityId])
  @@index([identityId])
}
