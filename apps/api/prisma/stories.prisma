enum StoryMediaType {
  IMAGE
  VIDEO
}

// PENDING: upload slot issued, not confirmed yet. ACTIVE: published.
// DELETED: removed by its author. FAILED: the upload did not pass the checks
// (or was replaced by a newer slot).
enum StoryStatus {
  PENDING
  ACTIVE
  DELETED
  FAILED
}

// A company's or office's story: a photo or video shown for 24 hours, then
// kept 30 days in its author's archive (only the author sees it), and for as
// long as it is in one of the author's highlights (shown on its profile).
// The media lives in the private stories/ prefix and is only ever served
// through short-lived signed links.
model Story {
  id               String               @id @default(uuid())
  identityId       String
  identity         Identity             @relation("StoryAuthor", fields: [identityId], references: [id], onDelete: Cascade)
  status           StoryStatus          @default(PENDING)
  mediaType        StoryMediaType
  // Generated by the server: stories/{identityId}/{storyId}/media.{ext}
  mediaKey         String               @unique
  mediaContentType String
  // Declared when the slot is issued, signed into the upload, re-checked on
  // publish
  mediaSizeBytes   Int
  posterKey        String?              @unique
  posterSizeBytes  Int?
  // From the server's own inspection of the file, never from the client
  width            Int?
  height           Int?
  durationMs       Int?
  caption          String?              @db.VarChar(200)
  // Optional link to one of the author's own listings
  propertyId       String?
  property         Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  publishedAt      DateTime?
  // PENDING: the upload deadline. ACTIVE: publishedAt + 24h. DELETED: still
  // publishedAt + 24h, so a deleted story keeps counting toward the 24-hour
  // publish limit (its files go at once). FAILED: when it may be purged
  expiresAt        DateTime
  deletedAt        DateTime?
  // Set once every file is confirmed deleted from S3 (deleted / failed
  // stories); until then the cleanup keeps retrying
  mediaDeletedAt   DateTime?
  failureReason    String?
  views            StoryView[]
  reports          Report[]
  highlightItems   StoryHighlightItem[]

  // Feed + cleanup
  @@index([status, expiresAt])
  // One author's stories + the per-author limits
  @@index([identityId, status, expiresAt])
}

// One view per viewer profile and story; the first one is kept
model StoryView {
  storyId          String
  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerIdentityId String
  viewer           Identity @relation("StoryViewer", fields: [viewerIdentityId], references: [id], onDelete: Cascade)
  viewedAt         DateTime @default(now())

  @@id([storyId, viewerIdentityId])
  @@index([viewerIdentityId])
  // The author's viewer list, newest first
  @@index([storyId, viewedAt])
}

// المميزة: a named collection of its author's stories, shown on the
// company's or office's profile after the stories' 24 hours
model StoryHighlight {
  id           String               @id @default(uuid())
  identityId   String
  identity     Identity             @relation("StoryHighlightAuthor", fields: [identityId], references: [id], onDelete: Cascade)
  title        String               @db.VarChar(20)
  // The story whose photo (or video poster) is its circle; null: the first
  coverStoryId String?
  // Its place on the profile, 0 first
  position     Int
  items        StoryHighlightItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([identityId, position])
}

// One story in a highlight, in its place. A story stays (files and row) for
// as long as it is in a highlight; the purge's row delete removes it here
model StoryHighlightItem {
  highlightId String
  highlight   StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  storyId     String
  story       Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  position    Int
  addedAt     DateTime       @default(now())

  @@id([highlightId, storyId])
  @@index([storyId])
}
