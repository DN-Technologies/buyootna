enum StoryMediaType {
  IMAGE
  VIDEO
}

// PENDING: upload slot issued, not confirmed yet. ACTIVE: published.
// DELETED: removed by its author. FAILED: the upload did not pass the checks
// (or was replaced by a newer slot).
enum StoryStatus {
  PENDING
  ACTIVE
  DELETED
  FAILED
}

// A company's or office's story: a photo (video later) shown for 24 hours.
// The media lives in the private stories/ prefix and is only ever served
// through short-lived signed links.
model Story {
  id               String         @id @default(uuid())
  identityId       String
  identity         Identity       @relation("StoryAuthor", fields: [identityId], references: [id], onDelete: Cascade)
  status           StoryStatus    @default(PENDING)
  mediaType        StoryMediaType
  // Generated by the server: stories/{identityId}/{storyId}/media.{ext}
  mediaKey         String         @unique
  mediaContentType String
  // Declared when the slot is issued, signed into the upload, re-checked on
  // publish
  mediaSizeBytes   Int
  posterKey        String?        @unique
  posterSizeBytes  Int?
  // From the server's own inspection of the file, never from the client
  width            Int?
  height           Int?
  durationMs       Int?
  caption          String?        @db.VarChar(200)
  // Optional link to one of the author's own listings
  propertyId       String?
  property         Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  publishedAt      DateTime?
  // PENDING: the upload deadline. ACTIVE: publishedAt + 24h. DELETED: still
  // publishedAt + 24h, so a deleted story keeps counting toward the 24-hour
  // publish limit (its files go at once). FAILED: when it may be purged
  expiresAt        DateTime
  deletedAt        DateTime?
  // Set once every file is confirmed deleted from S3 (deleted / failed
  // stories); until then the cleanup keeps retrying
  mediaDeletedAt   DateTime?
  failureReason    String?
  views            StoryView[]

  // Feed + cleanup
  @@index([status, expiresAt])
  // One author's stories + the per-author limits
  @@index([identityId, status, expiresAt])
}

// One view per viewer profile and story; the first one is kept
model StoryView {
  storyId          String
  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerIdentityId String
  viewer           Identity @relation("StoryViewer", fields: [viewerIdentityId], references: [id], onDelete: Cascade)
  viewedAt         DateTime @default(now())

  @@id([storyId, viewerIdentityId])
  @@index([viewerIdentityId])
}
