// PENDING: upload slot issued, not confirmed yet. ACTIVE: published.
// DELETED: removed by its author. FAILED: the upload did not pass the checks
// (or was replaced by a newer slot).
enum ReelStatus {
  PENDING
  ACTIVE
  DELETED
  FAILED
}

// A company's or office's short video, public and shown until it is deleted.
// The files live under the public reels/ prefix with stable links, so phones
// can cache them; the database keeps keys only and builds the links on read.
model Reel {
  id               String     @id @default(uuid())
  identityId       String
  identity         Identity   @relation("ReelAuthor", fields: [identityId], references: [id], onDelete: Cascade)
  status           ReelStatus @default(PENDING)
  // Generated by the server: reels/{identityId}/{reelId}/media.mp4
  mediaKey         String     @unique
  mediaContentType String
  // Declared when the slot is issued, signed into the upload, re-checked on
  // publish
  mediaSizeBytes   Int
  posterKey        String     @unique
  posterSizeBytes  Int
  // From the server's own inspection of the file, never from the client
  width            Int?
  height           Int?
  durationMs       Int?
  caption          String?    @db.VarChar(200)
  // Optional link to one of the author's own listings
  propertyId       String?
  property         Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Published with a listing. Stays true when the listing is deleted (and
  // propertyId goes null), so the reel doesn't return to the main feed
  hadListing       Boolean    @default(false)
  viewCount        Int        @default(0)
  likeCount        Int        @default(0)
  createdAt        DateTime   @default(now())
  // Publish after this and the slot is abandoned
  uploadExpiresAt  DateTime
  publishedAt      DateTime?
  deletedAt        DateTime?
  // Set once every file is confirmed deleted from S3 (deleted / failed
  // reels); until then the cleanup keeps retrying
  mediaDeletedAt   DateTime?
  failureReason    String?
  views            ReelView[]
  likes            ReelLike[]
  reports          Report[]

  // Feed + cleanup
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  // One author's reels
  @@index([identityId, status, publishedAt(sort: Desc)])
  // The per-author publish limit, deleted reels included
  @@index([identityId, publishedAt])
}

// One view per viewing profile and reel; the first one is kept. What "unseen
// first" reads. Rows older than 180 days are pruned (Reel.viewCount stays)
model ReelView {
  reelId           String
  reel             Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  viewerIdentityId String
  viewer           Identity @relation("ReelViewer", fields: [viewerIdentityId], references: [id], onDelete: Cascade)
  viewedAt         DateTime @default(now())

  @@id([reelId, viewerIdentityId])
  @@index([viewerIdentityId, reelId])
  @@index([viewedAt])
}

// One like per profile and reel
model ReelLike {
  reelId     String
  reel       Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  identityId String
  identity   Identity @relation("ReelLiker", fields: [identityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([reelId, identityId])
  @@index([identityId])
}
