generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                    @id @default(uuid())
  email             String?                   @unique
  phone             String?                   @unique
  password          String
  role              Role
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  freeAdsRemaining  Int                       @default(1)
  companyProfile    CompanyProfile?
  individualProfile IndividualProfile?
  officeProfile     OfficeProfile?
  otpCode           OtpCode?
  properties        Property[]
  deletionLogs      PropertyDeletionLog[]
  favorites         Favorite[]
  conversations     ConversationParticipant[]
  messages          Message[]
  givenReviews      Review[]                  @relation("GivenReviews")
  receivedReviews   Review[]                  @relation("ReceivedReviews")
  reviewReactions   ReviewReaction[]

  name             String?
  whatsapp         String?
  avatarUrl        String?
  isDisabled       Boolean                  @default(false)
  settings         UserSettings?
  notifPreferences NotificationPreferences?
  sessions         Session[]
  invoices         Invoice[]
  activePlanId     String?
  activePlan       Plan?                    @relation(fields: [activePlanId], references: [id])
}

model IndividualProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String?
  serviceAreas    String?
  about           String?
  licenseActivity String?
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  latitude        Float?
  longitude       Float?
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isVerified      Boolean         @default(false)
  specialty       String?
  licenseNumber   String
  status          ApprovalStatus  @default(PENDING)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRequests  ReviewRequest[]

  @@index([latitude, longitude])
}

model OfficeProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String?
  about           String?
  licenseActivity String?
  licenseNumber   String
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  isVerified      Boolean         @default(false)
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          ApprovalStatus  @default(PENDING)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRequests  ReviewRequest[]
}

model ReviewRequest {
  id               String          @id @default(uuid())
  companyProfileId String?
  officeProfileId  String?
  status           ApprovalStatus  @default(PENDING)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  officeProfile    OfficeProfile?  @relation(fields: [officeProfileId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Governorate {
  id         String     @id @default(uuid())
  name       String
  areas      Area[]
  properties Property[]
}

model Area {
  id            String      @id @default(uuid())
  name          String
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  properties    Property[]

  @@index([governorateId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserSettings {
  id            String  @id @default(uuid())
  userId        String  @unique
  showPhone     Boolean @default(true)
  showWhatsapp  Boolean @default(true)
  hideActivity  Boolean @default(false)
  hideOfficeAds Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id           String  @id @default(uuid())
  userId       String  @unique
  appEnabled   Boolean @default(true)
  emailEnabled Boolean @default(false)
  phoneEnabled Boolean @default(false)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  deviceName String
  isActive   Boolean  @default(true)
  lastActive DateTime @default(now())
  location   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  id             String   @id @default(uuid())
  slug           String   @unique // 'regular', 'silver', 'gold'
  name           String // 'العادية', 'الفضية', 'الذهبية'
  price          Float    @default(0)
  originalPrice  Float?
  discountText   String?
  badge          String?
  features       String[] // Postgres array
  color          String   @default("#15304D")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  maxActiveAds   Int      @default(1)
  durationDays   Int      @default(10)
  maxImagesPerAd Int      @default(5)
  featuredDays   Int      @default(0)
  prioritySearch Boolean  @default(false)
  users          User[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  planName    String
  planDetails String?
  amount      Float
  status      InvoiceStatus @default(PENDING)
  paidAt      DateTime?
  dueDate     DateTime?
  delayDays   Int? // e.g. 5 for notice
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Review {
  id           String           @id @default(uuid())
  reviewerId   String
  targetUserId String
  rating       Int              @default(5)
  comment      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reviewer     User             @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUser   User             @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
  reactions    ReviewReaction[]

  @@unique([reviewerId, targetUserId])
  @@index([targetUserId])
  @@index([reviewerId])
}

model ReviewReaction {
  id        String       @id @default(uuid())
  reviewId  String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}
