generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account-level flags
  isDisabled Boolean @default(false)
  isBlocked  Boolean @default(false)
  isAdmin    Boolean @default(false)

  // Relations
  identities       Identity[]
  otpCode          OtpCode?
  settings         UserSettings?
  notifPreferences NotificationPreferences?
  notifications    Notification[]
  sessions         Session[]
  socialAccounts   SocialAccount[]
  reportsFiled     Report[]                  @relation("ReporterReports")
  reportsAgainst   Report[]                  @relation("TargetUserReports")
  reportsResolved  Report[]                  @relation("ReportResolvedBy")
  reportsAssigned  Report[]                  @relation("ReportAssignedAdmin")

  // Legacy fields - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  role             Role?
  freeAdsRemaining Int?    @default(1)
  name             String?
  whatsapp         String?
  avatarUrl        String?
  activePlanId     String?
  activePlan       Plan?   @relation(fields: [activePlanId], references: [id])
}

// Legacy profile models - kept for backward compatibility during migration
// TODO: Remove after migration is complete

model IndividualProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Note: User relation removed as User no longer has these fields
}

model CompanyProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String?
  serviceAreas    String?
  about           String?
  licenseActivity String?
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  latitude        Float?
  longitude       Float?
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isVerified      Boolean         @default(false)
  specialty       String?
  licenseNumber   String
  status          ApprovalStatus  @default(PENDING)
  reviewRequests  ReviewRequest[] @relation("LegacyCompanyReviewRequests")

  @@index([latitude, longitude])
}

model OfficeProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String?
  about           String?
  licenseActivity String?
  licenseNumber   String
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  isVerified      Boolean         @default(false)
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          ApprovalStatus  @default(PENDING)
  reviewRequests  ReviewRequest[] @relation("LegacyOfficeReviewRequests")
}

model ReviewRequest {
  id        String         @id @default(uuid())
  status    ApprovalStatus @default(PENDING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // New identity-based relations
  companyIdentityDataId String?
  officeIdentityDataId  String?
  companyIdentityData   CompanyIdentityData? @relation("CompanyReviewRequests", fields: [companyIdentityDataId], references: [id], onDelete: Cascade)
  officeIdentityData    OfficeIdentityData?  @relation("OfficeReviewRequests", fields: [officeIdentityDataId], references: [id], onDelete: Cascade)

  // Legacy relations - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  companyProfileId String?
  officeProfileId  String?
  companyProfile   CompanyProfile? @relation("LegacyCompanyReviewRequests", fields: [companyProfileId], references: [id], onDelete: Cascade)
  officeProfile    OfficeProfile?  @relation("LegacyOfficeReviewRequests", fields: [officeProfileId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Governorate {
  id         String     @id @default(uuid())
  name       String
  areas      Area[]
  properties Property[]
}

model Area {
  id            String      @id @default(uuid())
  name          String
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  properties    Property[]

  @@index([governorateId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserSettings {
  id            String  @id @default(uuid())
  userId        String  @unique
  showPhone     Boolean @default(true)
  showWhatsapp  Boolean @default(true)
  hideActivity  Boolean @default(false)
  hideOfficeAds Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id           String  @id @default(uuid())
  userId       String  @unique
  appEnabled   Boolean @default(true)
  emailEnabled Boolean @default(false)
  phoneEnabled Boolean @default(false)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  IDENTITY_APPROVED
  IDENTITY_REJECTED
  IDENTITY_EDIT_REQUESTED
  ADMIN_CUSTOM_MESSAGE
  REPORT_RESOLVED
  REPORT_DISMISSED
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  identityId String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  deviceId    String?
  platform    String?
  deviceModel String?
  deviceName  String
  isActive    Boolean  @default(true)
  lastActive  DateTime @default(now())
  location    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Plan {
  id             String         @id @default(uuid())
  slug           String         @unique // 'regular', 'silver', 'gold'
  name           String // 'العادية', 'الفضية', 'الذهبية'
  price          Float          @default(0)
  originalPrice  Float?
  discountText   String?
  badge          String?
  features       String[] // Postgres array
  color          String         @default("#15304D")
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  maxActiveAds   Int            @default(1)
  durationDays   Int            @default(10)
  maxImagesPerAd Int            @default(5)
  featuredDays   Int            @default(0)
  prioritySearch Boolean        @default(false)
  users          User[]
  slots          UserPlanSlot[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String         @id @default(uuid())
  invoiceNo   String         @unique
  planName    String
  planDetails String?
  amount      Float
  status      InvoiceStatus  @default(PENDING)
  paidAt      DateTime?
  dueDate     DateTime?
  delayDays   Int? // e.g. 5 for notice
  planSlots   UserPlanSlot[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@index([identityId])
}

model UserPlanSlot {
  id           String     @id @default(uuid())
  planId       String
  adsRemaining Int
  status       SlotStatus @default(ACTIVE)
  invoiceId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  plan       Plan       @relation(fields: [planId], references: [id])
  invoice    Invoice?   @relation(fields: [invoiceId], references: [id])
  properties Property[]

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@index([identityId])
  @@index([status])
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Review {
  id        String           @id @default(uuid())
  rating    Int              @default(5)
  comment   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  reactions ReviewReaction[]

  // New identity-based relations
  reviewerIdentityId String?
  targetIdentityId   String?
  reviewerIdentity   Identity? @relation("IdentityGivenReviews", fields: [reviewerIdentityId], references: [id], onDelete: Cascade)
  targetIdentity     Identity? @relation("IdentityReceivedReviews", fields: [targetIdentityId], references: [id], onDelete: Cascade)

  // Legacy user-based relations - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  reviewerId   String?
  targetUserId String?

  @@unique([reviewerIdentityId, targetIdentityId])
  @@index([targetIdentityId])
  @@index([reviewerIdentityId])
}

model ReviewReaction {
  id        String       @id @default(uuid())
  reviewId  String
  type      ReactionType
  createdAt DateTime     @default(now())
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@unique([reviewId, identityId])
  @@index([reviewId])
  @@index([identityId])
}
