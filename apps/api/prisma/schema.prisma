// The client and the database. The models live in the other .prisma files in
// this folder, one per area (Prisma reads them all as one schema):
//   users, identity, legacy-profiles, locations, notifications, billing,
//   company-subscriptions, properties, favorites, alerts, reviews, chat,
//   stories, reels, company-requests, blocks, reports, admin, social-account,
//   docs, testing, faq; shared enums in enums.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
