generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String? @unique
  phone    String? @unique
  password String
  role     Role

  // Business Logic - Free Ads Quota
  freeAdsRemaining Int @default(1)

  // Relation
  individualProfile IndividualProfile?
  companyProfile    CompanyProfile?
  officeProfile     OfficeProfile?
  otpCode           OtpCode?
  properties        Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IndividualProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id              String  @id @default(uuid())
  name            String
  specialty       String? // e.g., 'finishing', 'plumbing'
  services        String? // Made optional
  hqLocation      String
  serviceAreas    String
  about           String? @db.Text // Made optional
  licenseActivity String?
  licenseNumber   String? // Added license number
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?

  isVerified Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeProfile {
  id              String   @id @default(uuid())
  name            String
  services        String?
  hqLocation      String
  about           String?  @db.Text // Made optional
  licenseActivity String?
  licenseNumber   String?
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?

  isVerified Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Password Recovery ---
model OtpCode {
  id        String   @id @default(uuid())
  code      String // The 6-digit OTP
  expiresAt DateTime // When this OTP becomes invalid

  // Relation to User
  userId String @unique // One active OTP per user at a time
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// --- Location Models ---
model Governorate {
  id         String     @id @default(uuid())
  name       String
  areas      Area[]
  properties Property[]
}

model Area {
  id   String @id @default(uuid())
  name String

  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)

  properties Property[]

  @@index([governorateId])
}
