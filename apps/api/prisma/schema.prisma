generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phone             String?            @unique
  password          String
  role              Role
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  freeAdsRemaining  Int                @default(1)
  companyProfile    CompanyProfile?
  individualProfile IndividualProfile?
  officeProfile     OfficeProfile?
  otpCode           OtpCode?
  properties        Property[]
  deletionLogs      PropertyDeletionLog[]
}

model IndividualProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String
  serviceAreas    String
  about           String?
  licenseActivity String?
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isVerified      Boolean         @default(false)
  specialty       String?
  licenseNumber   String?
  status          ApprovalStatus  @default(PENDING)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRequests  ReviewRequest[]
}

model OfficeProfile {
  id              String          @id @default(uuid())
  name            String
  services        String?
  hqLocation      String
  about           String?
  licenseActivity String?
  licenseNumber   String?
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  isVerified      Boolean         @default(false)
  userId          String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          ApprovalStatus  @default(PENDING)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRequests  ReviewRequest[]
}

model ReviewRequest {
  id               String          @id @default(uuid())
  companyProfileId String?
  officeProfileId  String?
  status           ApprovalStatus  @default(PENDING)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  officeProfile    OfficeProfile?  @relation(fields: [officeProfileId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Governorate {
  id         String     @id @default(uuid())
  name       String
  areas      Area[]
  properties Property[]
}

model Area {
  id            String      @id @default(uuid())
  name          String
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  properties    Property[]

  @@index([governorateId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
