model Alert {
  id         String   @id @default(uuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  type          AlertType
  operationType ListingType? // only SALE/RENT/EXCHANGE are meaningful here; enforced by CreateAlertDto, not the schema

  // Opaque local ids (matches how CreatePropertyDto.governorateId/areaId already
  // work -- mobile's location/category pickers use hardcoded local ids, not the
  // real Governorate/Area/PropertyCategory FKs, so no relation is enforced here).
  governorateId String
  areaId        String?
  categoryId    String?

  price        Float?
  rentValue    Float?
  areaSize     Float?
  rooms        Int?
  baths        Int?
  floors       Int?
  requestYear  Int?
  requiredYear Int?
  amenities    String[] @default([])

  startDate DateTime?
  endDate   DateTime?

  // Paused alerts are skipped by matching
  isActive      Boolean      @default(true)
  lastMatchedAt DateTime?
  matches       AlertMatch[]

  createdAt DateTime @default(now())

  @@index([identityId])
  @@index([isActive, type, governorateId])
}

// A listing that matched an alert when it was published. Unique per pair so
// a republished listing never notifies the same alert twice.
model AlertMatch {
  id         String   @id @default(uuid())
  alertId    String
  alert      Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  // Set when the owner opens the alert's matches; null ones are the home
  // avatar pill's gold "+N"
  seenAt     DateTime?

  @@unique([alertId, propertyId])
  @@index([propertyId])
  @@index([alertId, seenAt])
}
