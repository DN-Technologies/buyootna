model Property {
  id                 String           @id @default(uuid())
  referenceNumber    Int              @unique
  type               ListingType
  category           PropertyCategory
  isFeatured         Boolean          @default(false)
  featuredUntil      DateTime?
  isPriority         Boolean          @default(false)
  price              Float?
  beds               Int?             @default(1)
  baths              Int?             @default(1)
  location           String
  description        String
  images             String[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  views              Int              @default(0)
  areaId             String?
  areaSize           Float?
  auctionStatus      AuctionStatus?
  endDate            DateTime?
  floors             Int?
  features           Json             @default("[]")
  governorateId      String?
  requestYear        Int?
  requiredYear       Int?
  salePercentage     Float?
  startDate          DateTime?
  exchangeStatus     PropertyStatus?
  latitude           Float?
  longitude          Float?
  propertyAge        Int?
  propertyIncome     Float?
  status             ListingStatus    @default(DRAFT)
  isHidden           Boolean          @default(false)
  additionalExpenses String?
  automatedNumber    String?
  phoneNumber        String?
  rentConditions     String?
  planSlotId         String?
  planSlot           UserPlanSlot?    @relation(fields: [planSlotId], references: [id])
  area               Area?            @relation(fields: [areaId], references: [id])
  governorate        Governorate?     @relation(fields: [governorateId], references: [id])
  favorites          Favorite[]
  conversations      Conversation[]

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@index([type])
  @@index([price])
  @@index([areaSize])
  @@index([governorateId])
  @@index([areaId])
  @@index([category])
  @@index([status])
  @@index([latitude, longitude])
  @@index([identityId])
}

model PropertyDeletionLog {
  id         String   @id @default(uuid())
  propertyId String
  reason     String
  createdAt  DateTime @default(now())

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?
}
