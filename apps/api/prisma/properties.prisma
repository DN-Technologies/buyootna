model Property {
  id                 String           @id @default(uuid())
  type               ListingType
  category           PropertyCategory
  isFeatured         Boolean          @default(false)
  price              Float?
  beds               Int?             @default(1)
  baths              Int?             @default(1)
  location           String
  description        String
  images             String[]
  userId             String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  views              Int              @default(0)
  areaId             String?
  areaSize           Float?
  auctionStatus      AuctionStatus?
  endDate            DateTime?
  floors             Int?
  features           Json             @default("[]")
  governorateId      String?
  requestYear        Int?
  requiredYear       Int?
  salePercentage     Float?
  startDate          DateTime?
  exchangeStatus     PropertyStatus?
  latitude           Float?
  longitude          Float?
  propertyAge        Int?
  propertyIncome     Float?
  status             ListingStatus    @default(DRAFT)
  isHidden           Boolean          @default(false)
  additionalExpenses String?
  automatedNumber    String?
  phoneNumber        String?
  rentConditions     String?
  area               Area?            @relation(fields: [areaId], references: [id])
  governorate        Governorate?     @relation(fields: [governorateId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([price])
  @@index([areaSize])
  @@index([governorateId])
  @@index([areaId])
  @@index([category])
  @@index([status])
  @@index([latitude, longitude])
}

model PropertyDeletionLog {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  reason     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
