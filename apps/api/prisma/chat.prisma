model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // New identity-based relation
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@unique([conversationId, identityId])
  @@index([identityId])
  @@index([conversationId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  type           MessageType @default(TEXT)
  content        String?
  imageUrl       String?
  propertyId     String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // New identity-based relation
  senderIdentityId String?
  senderIdentity   Identity? @relation(fields: [senderIdentityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  senderId String?

  @@index([conversationId, createdAt])
  @@index([senderIdentityId])
}

enum MessageType {
  TEXT
  IMAGE
  PROPERTY
}
