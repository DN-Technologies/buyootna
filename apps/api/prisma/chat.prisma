model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]
  attachments  MessageAttachment[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Owning persona
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@unique([conversationId, identityId])
  @@index([identityId])
  @@index([conversationId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  type           MessageType @default(TEXT)
  content        String?
  imageUrl       String?
  propertyId     String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // New identity-based relation
  senderIdentityId String?
  senderIdentity   Identity? @relation(fields: [senderIdentityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  senderId String?

  // The message this one replies to (same conversation)
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Personas that deleted it on their side only (حذف لدي)
  hiddenFor MessageHidden[]

  // Photos / documents sent with it (private files, see MessageAttachment)
  attachments MessageAttachment[]

  // LOCATION: a map pin
  latitude      Float?
  longitude     Float?
  locationLabel String?

  // APPOINTMENT / OFFER: the proposal and its answer
  proposal ChatProposal?

  @@index([conversationId, createdAt])
  @@index([senderIdentityId])
}

// "حذف لدي": a message hidden for one persona; the other side still sees it
model MessageHidden {
  messageId  String
  identityId String
  createdAt  DateTime @default(now())

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([messageId, identityId])
  @@index([identityId])
}

enum MessageType {
  TEXT
  IMAGE
  PROPERTY
  FILE
  LOCATION
  APPOINTMENT
  OFFER
  VIDEO
  VOICE
}

enum AttachmentKind {
  IMAGE
  FILE
  VIDEO
  AUDIO
}

// A photo or document sent in a chat. Stored privately: only the
// conversation's personas get (short-lived) signed links to it. Uploaded
// first, then attached to the message it's sent with; unattached uploads
// are cleaned up after a day.
model MessageAttachment {
  id                 String         @id @default(uuid())
  conversationId     String
  uploaderIdentityId String
  messageId          String?
  kind               AttachmentKind
  // Private S3 object key (never a public URL)
  storageKey         String
  fileName           String
  mimeType           String
  size               Int
  width              Int?
  height             Int?
  // Video / voice note length
  durationMs         Int?
  // Video: a still image (private, like the file) shown before playing
  thumbnailKey       String?
  createdAt          DateTime       @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploaderIdentity Identity     @relation(fields: [uploaderIdentityId], references: [id], onDelete: Cascade)
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([conversationId])
  @@index([messageId, createdAt])
}

enum ProposalKind {
  APPOINTMENT
  OFFER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  // An offer answered with a counter-offer (a new proposal)
  COUNTERED
  CANCELLED
}

enum OfferPeriod {
  TOTAL
  MONTHLY
  YEARLY
}

// A viewing appointment (موعد معاينة) or a price offer (عرض سعر) sent in a
// chat. The other participant accepts / declines / counters it; the sender
// can cancel it while pending. A record in the chat, not a contract.
model ChatProposal {
  id            String         @id @default(uuid())
  messageId     String         @unique
  kind          ProposalKind
  status        ProposalStatus @default(PENDING)
  // APPOINTMENT
  scheduledAt   DateTime?
  // OFFER
  amount        Decimal?       @db.Decimal(14, 3)
  currency      String         @default("KWD")
  period        OfferPeriod?
  note          String?
  // The proposal this one answers (counter-offer / another time)
  counterOfId   String?
  respondedById String?
  respondedAt   DateTime?
  // The 1-hour-before push was sent (accepted appointments)
  remindedAt    DateTime?
  createdAt     DateTime       @default(now())

  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  counterOf ChatProposal?  @relation("ProposalCounters", fields: [counterOfId], references: [id], onDelete: SetNull)
  counters  ChatProposal[] @relation("ProposalCounters")

  @@index([kind, status, scheduledAt])
}
