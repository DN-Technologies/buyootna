model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]
  attachments  MessageAttachment[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Owning persona
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  userId String?

  @@unique([conversationId, identityId])
  @@index([identityId])
  @@index([conversationId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  type           MessageType @default(TEXT)
  content        String?
  imageUrl       String?
  propertyId     String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // New identity-based relation
  senderIdentityId String?
  senderIdentity   Identity? @relation(fields: [senderIdentityId], references: [id], onDelete: Cascade)

  // Legacy user-based relation - kept for backward compatibility during migration
  // TODO: Remove after migration is complete
  senderId String?

  // The message this one replies to (same conversation)
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Personas that deleted it on their side only (حذف لدي)
  hiddenFor MessageHidden[]

  // Photos / documents sent with it (private files, see MessageAttachment)
  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderIdentityId])
}

// "حذف لدي": a message hidden for one persona; the other side still sees it
model MessageHidden {
  messageId  String
  identityId String
  createdAt  DateTime @default(now())

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([messageId, identityId])
  @@index([identityId])
}

enum MessageType {
  TEXT
  IMAGE
  PROPERTY
  FILE
}

enum AttachmentKind {
  IMAGE
  FILE
}

// A photo or document sent in a chat. Stored privately: only the
// conversation's personas get (short-lived) signed links to it. Uploaded
// first, then attached to the message it's sent with; unattached uploads
// are cleaned up after a day.
model MessageAttachment {
  id                 String         @id @default(uuid())
  conversationId     String
  uploaderIdentityId String
  messageId          String?
  kind               AttachmentKind
  // Private S3 object key (never a public URL)
  storageKey         String
  fileName           String
  mimeType           String
  size               Int
  width              Int?
  height             Int?
  createdAt          DateTime       @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploaderIdentity Identity     @relation(fields: [uploaderIdentityId], references: [id], onDelete: Cascade)
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([conversationId])
  @@index([messageId, createdAt])
}
