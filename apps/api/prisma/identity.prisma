enum IdentityType {
  INDIVIDUAL
  COMPANY
  OFFICE
}

model Identity {
  id        String       @id @default(uuid())
  userId    String
  type      IdentityType
  // The persona used last, on any device -- what a brand-new device opens
  // with. Each device's own current persona is Session.activeIdentityId.
  isActive  Boolean      @default(false)
  // The welcome free ad: each persona has its own
  freeAdsRemaining Int   @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  // Last time this persona used the app (socket connect/disconnect or an
  // API request); drives the public "نشط الآن / نشط منذ" badge
  lastSeenAt DateTime?
  // How people reach this persona by phone (calls on its ads and profile).
  // On by default: the account's own (sign-in) number. Off: this persona's
  // own number, SMS-verified, e.g. a company's office line. Not unique and
  // never a sign-in identifier
  useAccountPhone        Boolean   @default(true)
  contactPhone           String?
  contactPhoneVerifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile data (polymorphic - one of these will be non-null)
  individualData IndividualIdentityData?
  companyData    CompanyIdentityData?
  officeData     OfficeIdentityData?

  // Devices currently using this persona
  activeOnSessions Session[]

  // Identity-scoped data
  properties      Property[]
  deletionLogs    PropertyDeletionLog[]
  favorites       Favorite[]
  // Companies/offices this identity favorited, and who favorited it
  providerFavorites   ProviderFavorite[] @relation("ProviderFavoriteOwner")
  favoritedByUsers    ProviderFavorite[] @relation("ProviderFavoriteTarget")
  conversations   ConversationParticipant[]
  messages        Message[]
  hiddenMessages  MessageHidden[]
  givenReviews    Review[]                  @relation("IdentityGivenReviews")
  receivedReviews Review[]                  @relation("IdentityReceivedReviews")
  reviewReactions ReviewReaction[]
  planSlots       UserPlanSlot[]
  invoices        Invoice[]
  projects        CompanyProject[]
  companyInvoices CompanyInvoice[]
  // Service invoices a company addressed to this persona (فواتير الخدمات)
  invoicesReceived CompanyInvoice[] @relation("InvoiceClient")
  reportsFiled    Report[]                  @relation("ReporterIdentityReports")
  reportsAgainst  Report[]                  @relation("TargetIdentityReports")
  alerts          Alert[]

  // Company-requests (leads marketplace)
  requestsAsClient CompanyRequest[] @relation("ClientRequests")
  requestsTargeted CompanyRequest[] @relation("TargetedRequests")
  requestsAccepted CompanyRequest[] @relation("AcceptedRequests")

  // One individual, one company and one office per account
  @@unique([userId, type])
  @@index([userId])
  @@index([userId, isActive])
}

model IndividualIdentityData {
  id         String   @id @default(uuid())
  identityId String   @unique
  name       String?
  whatsapp   String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model CompanyIdentityData {
  id              String         @id @default(uuid())
  identityId      String         @unique
  name            String
  services        String?
  hqLocation      String?
  serviceAreas    String?
  about           String?
  licenseActivity String?
  // Normalised (no spaces, Western digits); unique across companies AND
  // offices -- the cross-table half is enforced in IdentitiesService
  licenseNumber   String         @unique
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  latitude        Float?
  longitude       Float?
  specialty       String?
  isVerified      Boolean        @default(false)
  status          ApprovalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  identity       Identity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  reviewRequests ReviewRequest[] @relation("CompanyReviewRequests")

  @@index([latitude, longitude])
}

model OfficeIdentityData {
  id              String         @id @default(uuid())
  identityId      String         @unique
  name            String
  services        String?
  hqLocation      String?
  about           String?
  licenseActivity String?
  // Normalised (no spaces, Western digits); unique across companies AND
  // offices -- the cross-table half is enforced in IdentitiesService
  licenseNumber   String         @unique
  licenseExpiry   String?
  logoUrl         String?
  licenseFileUrl  String?
  isVerified      Boolean        @default(false)
  status          ApprovalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  identity       Identity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  reviewRequests ReviewRequest[] @relation("OfficeReviewRequests")
}

model CompanyProject {
  id          String   @id @default(uuid())
  identityId  String
  title       String
  description String
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model CompanyInvoice {
  id             String   @id @default(uuid())
  identityId     String
  invoiceNo      String   @unique
  clientName     String
  title          String
  warrantyMonths String?
  issueDate      DateTime
  items          Json
  subtotal       Float
  discount       Float    @default(0)
  total          Float
  status         String   @default("SENT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The client's persona, set when the company picked one of its accepted
  // requests; null for a client typed by name (outside the app)
  clientIdentityId String?
  clientIdentity   Identity?       @relation("InvoiceClient", fields: [clientIdentityId], references: [id], onDelete: SetNull)
  requestId        String?
  request          CompanyRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  // Set when the company marks it paid
  paidAt           DateTime?
  // The client removed it from their own list; the company keeps it
  clientDeletedAt  DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([clientIdentityId])
}
