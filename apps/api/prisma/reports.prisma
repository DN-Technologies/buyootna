enum ReportTargetType {
  USER
  PROPERTY
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  URGENT
}

model Report {
  id           String           @id @default(uuid())
  reportNumber Int              @unique
  targetType   ReportTargetType
  status       ReportStatus     @default(PENDING)
  priority     ReportPriority   @default(MEDIUM)
  reason       String
  description  String?

  reporterUserId     String
  reporterIdentityId String?
  reporterUser       User      @relation("ReporterReports", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reporterIdentity   Identity? @relation("ReporterIdentityReports", fields: [reporterIdentityId], references: [id], onDelete: SetNull)

  targetUserId     String?
  targetIdentityId String?
  targetUser       User?     @relation("TargetUserReports", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetIdentity   Identity? @relation("TargetIdentityReports", fields: [targetIdentityId], references: [id], onDelete: SetNull)

  targetPropertyId String?
  targetProperty   Property? @relation(fields: [targetPropertyId], references: [id], onDelete: SetNull)

  // A report made from a story: still a report against its author (USER),
  // linked to the story while it exists, with what it showed kept here
  // because the story itself is deleted within about a day
  targetStoryId       String?
  targetStory         Story?    @relation(fields: [targetStoryId], references: [id], onDelete: SetNull)
  targetStorySnapshot Json?

  resolvedAt         DateTime?
  resolvedByAdminId  String?
  resolvedByAdmin    User?     @relation("ReportResolvedBy", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  assignedAdminId String?
  assignedAdmin   User?   @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One report per reporting profile and story (other reports have no
  // story, and NULLs never collide)
  @@unique([reporterIdentityId, targetStoryId])
  @@index([targetStoryId])
  @@index([status])
  @@index([targetUserId])
  @@index([targetPropertyId])
  @@index([reporterUserId])
  @@index([assignedAdminId])
  @@index([createdAt])
}
