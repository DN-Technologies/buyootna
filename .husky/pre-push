while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  # The dev / prod flow (docs/ai/context.md, rule 3): both branches only
  # take pull requests. GitHub's branch protection enforces the same.
  if [ "$branch" = "main" ]; then
    echo ""
    echo "Blocked: direct push to 'main' is not allowed."
    echo "Open a release pull request from 'dev' into 'main' (or, for an"
    echo "urgent production fix, from a 'hotfix/*' branch) instead."
    echo ""
    exit 1
  fi
  if [ "$branch" = "dev" ]; then
    echo ""
    echo "Blocked: direct push to 'dev' is not allowed."
    echo "Push your branch and open a pull request into 'dev' instead."
    echo ""
    exit 1
  fi

  # Advisory mobile OTA release analysis. Never blocks the push: any failure
  # (node missing, script missing, non-interactive shell, etc.) is swallowed.
  # See apps/mobile/scripts/release-analysis.js and docs/OTA_RELEASE_WORKFLOW.md.
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  analyzer="$repo_root/apps/mobile/scripts/release-analysis.js"
  if [ -n "$repo_root" ] && [ -f "$analyzer" ] && command -v node >/dev/null 2>&1; then
    if ( : < /dev/tty ) 2>/dev/null; then
      node "$analyzer" "$local_sha" "$remote_sha" "$branch" < /dev/tty || true
    else
      node "$analyzer" "$local_sha" "$remote_sha" "$branch" < /dev/null || true
    fi
  fi
done
