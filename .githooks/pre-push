#!/bin/sh

# Prevent accidental direct push to main or master branch
current_branch=$(git rev-parse --abbrev-ref HEAD)

while read local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ] || [ "$current_branch" = "main" ]; then
    echo ""
    echo "================================================================="
    echo "🚨 ERROR: Direct push to 'main' is BLOCKED!"
    echo "-----------------------------------------------------------------"
    echo "Production code is running on 'main'."
    echo "Please push your commits to 'dev' and create a Pull Request."
    echo "================================================================="
    echo ""
    exit 1
  fi
done

exit 0
